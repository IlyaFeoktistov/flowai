OLLAMA_HOST=http://localhost:11434

# Текстовая модель — рекомендуется qwen3-coder:30b (agentic-кодинг, тул-коллы
# заточены под агента). На слабом/ограниченном железе (см. README → «Модели» —
# ориентир по железу и почему тут ровно два разумных варианта, без среднего)
# используй модель 7-8B (qwen3:8b / qwen3.5:9b) вместо промежуточных 14B —
# те не влезают в 6 GB VRAM целиком, но и не настолько лёгкие, чтобы это
# компенсировалось скоростью.
OLLAMA_MODEL=qwen3-coder:30b

# Vision-модель (чтение изображений)
# Варианты: llava:7b, llava:13b, moondream:1.8b, llava-phi3
VISION_MODEL=llava:7b

# Генерация изображений (требует GPU и: pip install diffusers torch transformers accelerate)
# Варианты: stabilityai/sdxl-turbo, runwayml/stable-diffusion-v1-5
IMAGE_GEN_MODEL=stabilityai/sdxl-turbo

# Токен HuggingFace — снимает rate limit на скачивание (получить: hf.co/settings/tokens)
HF_TOKEN=

# Локальный поисковик SearXNG (запуск: docker compose up -d)
SEARXNG_URL=http://localhost:8888

DEBUG=1